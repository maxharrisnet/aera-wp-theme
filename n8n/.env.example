# n8n Admin
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# n8n Webhook URL
# Local dev: your ngrok URL (e.g. https://xxxx.ngrok.io)
# Production: your deployed URL (e.g. https://n8n.yourdomain.com)
N8N_WEBHOOK_URL=https://xxxx.ngrok.io

# WordPress (Local by Flywheel for dev, WP Engine for prod)
WP_BASE_URL=http://localhost:10020
WP_USERNAME=max
WP_APP_PASSWORD=

# Anthropic
ANTHROPIC_API_KEY=

# Slack
# Bot User OAuth Token from your Slack app (xoxb-...)
SLACK_BOT_TOKEN=
# Channel ID where notifications are posted (not the name — the C... ID)
SLACK_DEFAULT_CHANNEL=

# Google Drive
# Folder ID from the Drive URL: drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=
# Inline JSON of the service account credentials (or a file path for local dev)
GOOGLE_SERVICE_ACCOUNT_JSON=
